{
  "$schema": "uinaf design tokens v2",
  "$source": "src/tokens.css (generated in the build — do not hand-edit)",
  "groups": {
    "typography": {
      "--font-mono": "\"Berkeley Mono\", ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, Consolas, monospace",
      "--font-sans": "var(--font-mono)",
      "--font-display": "var(--font-mono)",
      "--text-2xs": "10px",
      "--text-xs": "11px",
      "--text-sm": "13px",
      "--text-base": "14px",
      "--text-md": "16px",
      "--text-lg": "20px",
      "--text-xl": "24px",
      "--text-2xl": "32px",
      "--text-3xl": "40px",
      "--leading-tight": "1.15",
      "--leading-snug": "1.3",
      "--leading-base": "1.6",
      "--leading-loose": "1.75",
      "--tracking-tight": "-0.01em",
      "--tracking-base": "0",
      "--tracking-caps": "0.08em",
      "--weight-regular": "400",
      "--weight-bold": "700"
    },
    "neutrals": {
      "--neutral-950": "rgb(10, 10, 10)",
      "--neutral-925": "rgb(16, 16, 16)",
      "--neutral-900": "rgb(23, 23, 23)",
      "--neutral-850": "rgb(32, 32, 32)",
      "--neutral-800": "rgb(38, 38, 38)",
      "--neutral-700": "rgb(64, 64, 64)",
      "--neutral-600": "rgb(82, 82, 82)",
      "--neutral-500": "rgb(115, 115, 115)",
      "--neutral-400": "rgb(163, 163, 163)",
      "--neutral-300": "rgb(212, 212, 212)",
      "--neutral-200": "rgb(229, 229, 229)",
      "--neutral-100": "rgb(245, 245, 245)",
      "--neutral-050": "rgb(250, 250, 250)"
    },
    "accent": {
      "--accent": "#d4ff3f",
      "--accent-ink": "var(--neutral-950)",
      "--accent-down": "#b8e32e",
      "--accent-soft": "rgba(212, 255, 63, 0.12)",
      "--accent-glow": "0 0 10px rgba(212, 255, 63, 0.45)"
    },
    "links": {
      "--link": "var(--fg)",
      "--link-hover": "var(--accent)",
      "--link-underline": "var(--neutral-500)",
      "--link-underline-offset": "3px"
    },
    "slime": {
      "--slime-lime": "#d4ff3f",
      "--slime-cyan": "#3fffe6",
      "--slime-green": "#6bffb0",
      "--slime-blue": "#4b7bff",
      "--slime-purple": "#8a4bff",
      "--slime-magenta": "#e646ff",
      "--slime-pink": "#ff6bd6"
    },
    "viz": {
      "--viz-1": "var(--accent)",
      "--viz-2": "var(--slime-cyan)",
      "--viz-3": "var(--slime-purple)",
      "--viz-4": "var(--slime-magenta)",
      "--viz-5": "var(--slime-green)"
    },
    "status": {
      "--ok": "#7fd996",
      "--warn": "#d9c878",
      "--error": "#e07a8b",
      "--info": "var(--fg-muted)"
    },
    "spacing": {
      "--sp-0": "0",
      "--sp-0-5": "2px",
      "--sp-1": "4px",
      "--sp-1-5": "6px",
      "--sp-2": "8px",
      "--sp-2-5": "10px",
      "--sp-3": "12px",
      "--sp-3-5": "14px",
      "--sp-4": "16px",
      "--sp-5": "20px",
      "--sp-6": "24px",
      "--sp-7": "28px",
      "--sp-8": "32px",
      "--sp-9": "36px",
      "--sp-10": "40px",
      "--sp-12": "48px",
      "--sp-14": "56px",
      "--sp-16": "64px",
      "--sp-18": "72px",
      "--sp-20": "80px",
      "--sp-24": "96px"
    },
    "radius": {
      "--radius-none": "0",
      "--radius-xs": "2px",
      "--radius-sm": "4px",
      "--radius-md": "6px",
      "--radius-pill": "9999px"
    },
    "borders": {
      "--hairline": "1px solid var(--border)",
      "--hairline-soft": "1px solid var(--border-soft)",
      "--hairline-dashed": "1px dashed var(--border)"
    },
    "shadows": {
      "--shadow-none": "none",
      "--shadow-glow-accent": "0 0 24px -4px rgba(212, 255, 63, 0.3)"
    },
    "motion": {
      "--ease-snappy": "cubic-bezier(0.22, 1, 0.36, 1)",
      "--duration-fast": "160ms",
      "--duration-base": "220ms",
      "--stagger-step": "45ms"
    },
    "layout": {
      "--container-narrow": "40rem",
      "--container-base": "48rem",
      "--container-wide": "72rem"
    },
    "semantic": {
      "--bg": "var(--neutral-950)",
      "--bg-raised": "var(--neutral-900)",
      "--bg-card": "rgba(16, 16, 16, 0.55)",
      "--bg-hover": "rgba(23, 23, 23, 0.45)",
      "--bg-overlay": "rgba(0, 0, 0, 0.6)",
      "--fg": "var(--neutral-200)",
      "--fg-strong": "var(--neutral-100)",
      "--fg-muted": "var(--neutral-400)",
      "--fg-subtle": "var(--neutral-600)",
      "--fg-faint": "var(--neutral-700)",
      "--border": "var(--neutral-800)",
      "--border-soft": "rgba(38, 38, 38, 0.9)",
      "--border-hover": "var(--neutral-500)",
      "--border-strong": "var(--neutral-700)",
      "--tick": "var(--neutral-600)"
    }
  }
}
