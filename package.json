{
  "name": "@uinaf/design",
  "version": "1.16.0",
  "description": "uinaf design tokens, CSS primitives, and agent guidance",
  "homepage": "https://design.uinaf.dev",
  "bugs": {
    "url": "https://github.com/uinaf/design/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uinaf/design.git"
  },
  "bin": {
    "design-check": "./dist/lint/cli.js"
  },
  "files": [
    "dist",
    "DESIGN.md",
    "assets"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "default": "./dist/tokens.js"
    },
    "./css": "./dist/css/tokens.css",
    "./tokens.css": "./dist/css/tokens.css",
    "./components.css": "./dist/css/components.css",
    "./tokens.json": "./dist/tokens.json",
    "./components.json": "./dist/components.json",
    "./cdn": {
      "types": "./dist/cdn.d.ts",
      "import": "./dist/cdn.js",
      "default": "./dist/cdn.js"
    },
    "./package.json": "./package.json",
    "./lint": {
      "types": "./dist/lint/index.d.ts",
      "import": "./dist/lint/index.js",
      "default": "./dist/lint/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "guide:sync": "node scripts/build.ts && node scripts/sync-guide.ts && node scripts/machine-layer.ts",
    "cdn:check": "node scripts/cdn-check.ts",
    "test": "vp test run",
    "audit": "pnpm audit --audit-level high",
    "verify": "pnpm run audit && vp run verifyPure && ./scripts/smoke.sh",
    "verify:full": "pnpm run audit && vp run --no-cache verifyPure && ./scripts/smoke.sh",
    "deploy": "pnpm run guide:sync && wrangler deploy",
    "prepare": "vp config --no-agent",
    "prepublishOnly": "pnpm run build && node scripts/check.ts",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "types:worker": "wrangler types",
    "smoke": "pnpm run guide:sync && ./scripts/smoke.sh",
    "design:check": "node src/lint/cli.ts preview pages templates guide --ratchet --ignore guide/tokens.css --ignore guide/components.css --except templates/export-:type-scale-only,spacing-grid",
    "design:check:update": "node src/lint/cli.ts preview pages templates guide --update-ratchet --ignore guide/tokens.css --ignore guide/components.css --except templates/export-:type-scale-only,spacing-grid"
  },
  "dependencies": {
    "postcss": "^8.5.26"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^24.0.0",
    "agents": "^0.23.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.131.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.18.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@12.4.2"
}
